PORT=5000
MONGO_URI="mongodb://localhost:27017/streamVibe"
JWT_SECRET=replace-with-a-long-random-string
REFRESH_TOKEN_SECRET=replace-with-a-different-long-random-string
FRONT_ADDRESS="http://localhost:3000"
RESEND_API_KEY=replace-with-your-resend-api-key

# Cinema payments. Test keys only — this project never takes real money.
# Both come from https://dashboard.stripe.com/test/apikeys with Test mode on.
STRIPE_SECRET_KEY=sk_test_replace-with-your-stripe-test-secret-key
# Printed by `stripe listen --forward-to localhost:5000/api/payment/webhook`.
STRIPE_WEBHOOK_SECRET=whsec_replace-with-your-webhook-signing-secret
# Only set this to point the SDK at a local stand-in for Stripe; leave it out
# to talk to the real test-mode API.
# STRIPE_API_HOST=localhost:12111
